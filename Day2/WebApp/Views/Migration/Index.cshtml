@{
    ViewData["Title"] = "GitHub Migration Tool";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            padding: 20px;
            color: #333;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
        }

        .header {
            text-align: center;
            color: white;
            margin-bottom: 40px;
            animation: fadeInDown 0.8s ease-out;
        }

        .header h1 {
            font-size: 2.5em;
            margin-bottom: 10px;
            text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.2);
        }

        .header p {
            font-size: 1.2em;
            opacity: 0.9;
        }

        .mode-selector {
            display: flex;
            gap: 20px;
            margin-bottom: 30px;
            animation: fadeInUp 0.8s ease-out;
        }

        .mode-card {
            flex: 1;
            background: rgba(255, 255, 255, 0.95);
            border-radius: 20px;
            padding: 30px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
            cursor: pointer;
            transition: all 0.3s ease;
            backdrop-filter: blur(10px);
            border: 2px solid transparent;
        }

        .mode-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 40px rgba(0, 0, 0, 0.3);
            border-color: #667eea;
        }

        .mode-card.active {
            border-color: #667eea;
            background: rgba(102, 126, 234, 0.1);
        }

        .mode-card h3 {
            color: #667eea;
            font-size: 1.8em;
            margin-bottom: 15px;
        }

        .mode-card p {
            color: #666;
            line-height: 1.6;
        }

        .form-container {
            background: rgba(255, 255, 255, 0.95);
            border-radius: 20px;
            padding: 40px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
            margin-bottom: 30px;
            display: none;
            animation: fadeIn 0.5s ease-out;
            backdrop-filter: blur(10px);
        }

        .form-container.active {
            display: block;
        }

        .form-group {
            margin-bottom: 25px;
        }

        .form-group label {
            display: block;
            color: #333;
            font-weight: 600;
            margin-bottom: 8px;
            font-size: 1.1em;
        }

        .form-group input {
            width: 100%;
            padding: 15px;
            border: 2px solid #e0e0e0;
            border-radius: 10px;
            font-size: 1em;
            transition: all 0.3s ease;
            background: rgba(255, 255, 255, 0.9);
        }

        .form-group input:focus {
            outline: none;
            border-color: #667eea;
            box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
        }

        .btn-submit {
            width: 100%;
            padding: 18px;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            border: none;
            border-radius: 10px;
            font-size: 1.2em;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            box-shadow: 0 5px 15px rgba(102, 126, 234, 0.4);
        }

        .btn-submit:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(102, 126, 234, 0.6);
        }

        .btn-submit:active {
            transform: translateY(0);
        }

        .btn-submit:disabled {
            opacity: 0.6;
            cursor: not-allowed;
        }

        .loading {
            display: none;
            text-align: center;
            padding: 40px;
            background: rgba(255, 255, 255, 0.95);
            border-radius: 20px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
            margin-bottom: 30px;
        }

        .loading.active {
            display: block;
            animation: fadeIn 0.5s ease-out;
        }

        .spinner {
            border: 4px solid rgba(102, 126, 234, 0.2);
            border-left-color: #667eea;
            border-radius: 50%;
            width: 50px;
            height: 50px;
            animation: spin 1s linear infinite;
            margin: 0 auto 20px;
        }

        .results {
            display: none;
            background: rgba(255, 255, 255, 0.95);
            border-radius: 20px;
            padding: 40px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
            animation: fadeIn 0.5s ease-out;
        }

        .results.active {
            display: block;
        }

        .results h3 {
            color: #667eea;
            font-size: 1.8em;
            margin-bottom: 20px;
        }

        .report-content {
            background: #f8f9fa;
            padding: 25px;
            border-radius: 10px;
            font-family: 'Courier New', monospace;
            white-space: pre-wrap;
            max-height: 500px;
            overflow-y: auto;
            margin-bottom: 20px;
            border: 2px solid #e0e0e0;
        }

        .btn-download {
            display: inline-block;
            padding: 15px 30px;
            background: linear-gradient(135deg, #28a745 0%, #20c997 100%);
            color: white;
            text-decoration: none;
            border-radius: 10px;
            font-weight: 600;
            transition: all 0.3s ease;
            box-shadow: 0 5px 15px rgba(40, 167, 69, 0.4);
        }

        .btn-download:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(40, 167, 69, 0.6);
        }

        .error-message {
            background: #f8d7da;
            color: #721c24;
            padding: 15px;
            border-radius: 10px;
            margin-bottom: 20px;
            border: 2px solid #f5c6cb;
        }

        .success-message {
            background: #d4edda;
            color: #155724;
            padding: 15px;
            border-radius: 10px;
            margin-bottom: 20px;
            border: 2px solid #c3e6cb;
        }

        @@keyframes fadeInDown {
            from {
                opacity: 0;
                transform: translateY(-30px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @@keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(30px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @@keyframes fadeIn {
            from {
                opacity: 0;
            }
            to {
                opacity: 1;
            }
        }

        @@keyframes spin {
            to {
                transform: rotate(360deg);
            }
        }

        @@media (max-width: 768px) {
            .mode-selector {
                flex-direction: column;
            }

            .header h1 {
                font-size: 2em;
            }

            .form-container {
                padding: 25px;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>🚀 GitHub Migration Tool</h1>
            <p>Seamlessly migrate repositories and issues between GitHub organizations</p>
        </div>

        <div class="mode-selector">
            <div class="mode-card" id="testModeCard">
                <h3>🧪 Test Mode</h3>
                <p>Run a quick test migration with dummy data to verify functionality. No GitHub credentials required.</p>
            </div>
            <div class="mode-card" id="normalModeCard">
                <h3>🔄 Normal Mode</h3>
                <p>Perform an actual migration between GitHub organizations. Requires valid Personal Access Tokens.</p>
            </div>
        </div>

        <div class="form-container" id="testForm">
            <h3>Test Mode</h3>
            <p style="margin-bottom: 20px; color: #666;">Click the button below to run a test migration with dummy data.</p>
            <button class="btn-submit" onclick="runTestMode()">Run Test Migration</button>
        </div>

        <div class="form-container" id="normalForm">
            <h3>Normal Mode Configuration</h3>
            <form id="migrationForm">
                <div class="form-group">
                    <label for="sourceToken">Source Personal Access Token</label>
                    <input type="password" id="sourceToken" name="sourceToken" placeholder="ghp_xxxxxxxxxxxxxxxxxx" required>
                </div>
                <div class="form-group">
                    <label for="sourceOrg">Source Organization</label>
                    <input type="text" id="sourceOrg" name="sourceOrg" placeholder="source-organization" required>
                </div>
                <div class="form-group">
                    <label for="targetToken">Target Personal Access Token</label>
                    <input type="password" id="targetToken" name="targetToken" placeholder="ghp_xxxxxxxxxxxxxxxxxx" required>
                </div>
                <div class="form-group">
                    <label for="targetOrg">Target Organization</label>
                    <input type="text" id="targetOrg" name="targetOrg" placeholder="target-organization" required>
                </div>
                <button type="submit" class="btn-submit">Start Migration</button>
            </form>
        </div>

        <div class="loading" id="loading">
            <div class="spinner"></div>
            <p style="color: #667eea; font-size: 1.2em; font-weight: 600;">Processing migration...</p>
        </div>

        <div class="results" id="results">
            <h3 id="resultsTitle">Migration Results</h3>
            <div id="messageContainer"></div>
            <div class="report-content" id="reportContent"></div>
            <a href="#" class="btn-download" id="downloadBtn" style="display: none;">📥 Download Report</a>
        </div>
    </div>

    <script>
        const testModeCard = document.getElementById('testModeCard');
        const normalModeCard = document.getElementById('normalModeCard');
        const testForm = document.getElementById('testForm');
        const normalForm = document.getElementById('normalForm');
        const loading = document.getElementById('loading');
        const results = document.getElementById('results');

        testModeCard.addEventListener('click', () => {
            testModeCard.classList.add('active');
            normalModeCard.classList.remove('active');
            testForm.classList.add('active');
            normalForm.classList.remove('active');
            results.classList.remove('active');
        });

        normalModeCard.addEventListener('click', () => {
            normalModeCard.classList.add('active');
            testModeCard.classList.remove('active');
            normalForm.classList.add('active');
            testForm.classList.remove('active');
            results.classList.remove('active');
        });

        async function runTestMode() {
            loading.classList.add('active');
            results.classList.remove('active');

            try {
                const response = await fetch('/Migration/RunTestMode', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    }
                });

                const data = await response.json();
                displayResults(data, 'test');
            } catch (error) {
                displayError('Failed to execute test mode: ' + error.message);
            } finally {
                loading.classList.remove('active');
            }
        }

        document.getElementById('migrationForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            loading.classList.add('active');
            results.classList.remove('active');

            const formData = new FormData(e.target);
            const data = {
                sourceToken: formData.get('sourceToken'),
                sourceOrg: formData.get('sourceOrg'),
                targetToken: formData.get('targetToken'),
                targetOrg: formData.get('targetOrg')
            };

            try {
                const response = await fetch('/Migration/RunNormalMode', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(data)
                });

                const result = await response.json();
                displayResults(result, 'normal');
            } catch (error) {
                displayError('Failed to execute migration: ' + error.message);
            } finally {
                loading.classList.remove('active');
            }
        });

        function displayResults(data, mode) {
            const messageContainer = document.getElementById('messageContainer');
            const reportContent = document.getElementById('reportContent');
            const downloadBtn = document.getElementById('downloadBtn');

            if (data.success) {
                messageContainer.innerHTML = `<div class="success-message">✅ ${data.message}</div>`;
                reportContent.textContent = data.report;
                downloadBtn.style.display = 'inline-block';
                downloadBtn.href = `/Migration/DownloadReport?timestamp=${data.timestamp}&mode=${mode}`;
            } else {
                messageContainer.innerHTML = `<div class="error-message">❌ ${data.message}</div>`;
                reportContent.textContent = data.report || 'No report available';
                downloadBtn.style.display = 'none';
            }

            results.classList.add('active');
        }

        function displayError(message) {
            const messageContainer = document.getElementById('messageContainer');
            const reportContent = document.getElementById('reportContent');
            const downloadBtn = document.getElementById('downloadBtn');

            messageContainer.innerHTML = `<div class="error-message">❌ ${message}</div>`;
            reportContent.textContent = 'An error occurred during migration.';
            downloadBtn.style.display = 'none';
            results.classList.add('active');
        }
    </script>
</body>
</html>
